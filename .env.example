# ============================================================
# Longitudinal Health & Nutrition Review Agent — Environment
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/longitudinal_health_agent
# For Atlas: MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/longitudinal_health_agent

# --- AI API ---
# Gemini / OpenAI / Anthropic — uncomment whichever you use
AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI model identifiers
AI_MODEL_NAME=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# --- Logging ---
LOG_LEVEL=debug
LOG_DIR=logs

# --- Security ---
CORS_ORIGIN=http://localhost:3001
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
