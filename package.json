{
  "name": "longitudinal-health-agent",
  "version": "1.0.0",
  "description": "Production-grade Longitudinal Health and Nutrition Review Agent backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts scripts/**/*.ts --fix",
    "test": "jest --coverage --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.4.1",
    "openai": "^7.3.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "health",
    "nutrition",
    "ai-agent",
    "longitudinal",
    "typescript",
    "express",
    "mongodb"
  ],
  "license": "MIT"
}
